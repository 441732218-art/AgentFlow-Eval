# -*- coding: utf-8 -*-
"""补丁：按 SEGMENT_BREAK 标记分割前后段，精确裁剪到 3000 有效行。"""
import pathlib

SRC = pathlib.Path(r"D:\AgentFlow-Eval\copyright_output\source_code_60pages.txt")
lines = SRC.read_text(encoding="utf-8").splitlines()

def eff(s):
    t = s.strip()
    return t != "" and not t.startswith("#")

TARGET = 3000

# 查找段分隔标记
seg_idx = None
for i, s in enumerate(lines):
    if s.strip() == "# === SEGMENT_BREAK ===":
        seg_idx = i
        break

if seg_idx is not None:
    # ---- 有标记：前段全保留，后段按需截取 ----
    front = lines[:seg_idx]                    # 前段（不含标记行）
    back_src = lines[seg_idx + 1:]             # 后段（含 SEP + 代码）

    front_eff = sum(1 for s in front if eff(s))
    remaining = TARGET - front_eff
    print(f"[INFO] 前段有效行={front_eff}, 还需={remaining}")

    if remaining <= 0:
        # 前段已够 3000（极少发生）
        trimmed = front[:]
        for i, s in enumerate(front):
            if eff(s):
                # 计入有效行，但不在此场景裁剪；仅兜底保留全部前段
                pass
    else:
        back_trimmed = []
        back_eff = 0
        for s in back_src:
            back_trimmed.append(s)
            if eff(s):
                back_eff += 1
            if back_eff >= remaining:
                # 已收集足够有效行（可能多出 0~几条，可接受）
                break

        # 吸收尾部空行
        while back_trimmed and back_trimmed[-1].strip() == "":
            back_trimmed.pop()

        trimmed = front + back_trimmed

else:
    # ---- 降级：无标记，沿用旧逻辑 ----
    print("[WARN] 未找到 SEGMENT_BREAK 标记，使用传统裁剪")
    count = 0
    cut = len(lines)
    for i, s in enumerate(lines):
        if eff(s):
            count += 1
            if count == TARGET:
                cut = i + 1
                break

    trimmed = lines[:cut]
    while trimmed and trimmed[-1].strip() == "":
        trimmed.pop()

SRC.write_text("\n".join(trimmed) + "\n", encoding="utf-8")
final_eff = sum(1 for s in trimmed if eff(s))
print(f"[OK] 裁剪完成: 物理行 {len(trimmed)}, 有效行 {final_eff}")

    def to_dict(self) -> dict[str, Any]:
        return {
            "plugin_id": self.plugin_id,
            "entry": self.entry,
            "source": self.source,
            "state": self.state.value,
            "meta": self.meta.to_dict() if self.meta else None,
            "error": self.error,
            "path": self.path,
            "config": dict(self.config),

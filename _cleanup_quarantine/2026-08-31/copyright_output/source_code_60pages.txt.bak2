            market = get_plugin_market()
            if getattr(settings, "PLUGIN_MARKET_SEED_EXAMPLES", True):
                market.seed_builtin_catalog()
            catalog = getattr(settings, "PLUGIN_CATALOG_PATH", "") or ""
            if catalog:

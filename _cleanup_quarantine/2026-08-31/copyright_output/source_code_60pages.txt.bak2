    allow_credentials=True,
    allow_methods=["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    allow_headers=[
        "Authorization",
        "Content-Type",
        "X-Request-ID",
        "X-Trace-ID",
        "X-API-Key",
    ],
    expose_headers=["X-Request-ID", "X-Trace-ID", "X-Error-ID"],
)

# ---- Trusted hosts ----
if settings.is_prod:
    app.add_middleware(TrustedHostMiddleware, allowed_hosts=["*"])

# ---- Routes ----
